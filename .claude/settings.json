{
  "permissions": {
    "allow": [
      "Bash(flutter pub get)",
      "Bash(flutter analyze:*)",
      "Bash(flutter test:*)",
      "Bash(flutter run:*)",
      "Bash(flutter build web:*)",
      "Bash(dart run tool/simulate.dart:*)",
      "Bash(dart format:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Bash(flutter build appbundle:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(rm:*)"
    ],
    "deny": [
      "Read(android/key.properties)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/google-services.json)",
      "Bash(git push --force:*)"
    ]
  }
}
